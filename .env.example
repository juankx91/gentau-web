# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# Turso (base de datos)
TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
TURSO_AUTH_TOKEN=

# Cloudinary (imágenes y video)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Panel de administrador
ADMIN_PASSWORD=pon-una-clave-larga-y-segura
SESSION_SECRET=pon-un-texto-aleatorio-de-32-caracteres-o-mas
