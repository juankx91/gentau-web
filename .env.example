# ============================================================
#  Copia este archivo como ".env" y llena tus datos reales.
#  En Render, estas mismas variables se agregan en "Environment".
# ============================================================

# --- Turso (base de datos) ---
# Si lo dejas vacío, en tu computador se usa un archivo local "local.db"
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso

# --- Cloudinary (fotos y video) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Panel de administrador ---
ADMIN_PASSWORD=cambia-esta-clave
# Una frase larga y aleatoria (sirve para firmar la sesión del admin)
SESSION_SECRET=escribe-aqui-una-frase-larga-y-secreta-123
