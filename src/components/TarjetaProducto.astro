---
// Tarjeta de un producto: foto, categoría, nombre, descripción y precio
import { precioCOP } from '../lib/formato.js';
import { optimizar } from '../lib/cloudinary.js';
import { site } from '../config/site.js';
import Icono from './Icono.astro';

interface Props { producto: any }
const { producto } = Astro.props;
const mensaje = encodeURIComponent(`Hola GENTAU, me interesa el producto: ${producto.nombre} (${precioCOP(producto.precio)})`);
---
<article class="producto" data-categoria={producto.categoria}>
  <div class="producto__imagen">
    {producto.imagen_url ? (
      <img src={optimizar(producto.imagen_url, 600)} alt={producto.nombre} loading="lazy" />
    ) : (
      <div class="producto__sin-foto"><Icono nombre="percha" tam={54} /><span>GENTAU</span></div>
    )}
    <span class="producto__categoria">{producto.categoria}</span>
    {Number(producto.destacado) === 1 && <span class="producto__destacado">Destacado</span>}
  </div>
  <div class="producto__info">
    <h3>{producto.nombre}</h3>
    <p>{producto.descripcion}</p>
    <div class="producto__pie">
      <strong class="producto__precio">{precioCOP(producto.precio)}</strong>
      <a href={`https://wa.me/${site.whatsapp}?text=${mensaje}`} target="_blank" rel="noopener" class="producto__pedir">
        Pedir <Icono nombre="whatsapp" tam={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .producto {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--borde);
    box-shadow: var(--sombra);
    transition: transform var(--transicion), box-shadow var(--transicion);
  }
  .producto:hover { transform: translateY(-6px); box-shadow: var(--sombra-fuerte); }
  .producto__imagen { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--menta); }
  .producto__imagen img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
  .producto:hover .producto__imagen img { transform: scale(1.07); }
  .producto__sin-foto {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--dorado);
    background:
      radial-gradient(circle at 30% 20%, rgba(232, 206, 115, 0.25), transparent 50%),
      linear-gradient(160deg, var(--verde-oscuro), var(--verde-noche));
  }
  .producto__sin-foto span { font-family: var(--fuente-titulos); letter-spacing: 0.3em; color: var(--dorado-claro); }
  .producto__categoria,
  .producto__destacado {
    position: absolute;
    top: 1rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .producto__categoria { left: 1rem; background: rgba(255, 255, 255, 0.92); color: var(--verde-oscuro); }
  .producto__destacado { right: 1rem; background: var(--degradado-dorado); color: var(--verde-noche); }
  .producto__info { display: flex; flex-direction: column; flex: 1; padding: 1.5rem; }
  .producto__info h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .producto__info p { font-size: 0.88rem; color: var(--texto-suave); flex: 1; }
  .producto__pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--borde);
  }
  .producto__precio { font-family: var(--fuente-titulos); font-size: 1.2rem; color: var(--verde-oscuro); }
  .producto__pedir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--verde-oscuro);
    color: var(--dorado-claro);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background var(--transicion);
  }
  .producto__pedir:hover { background: var(--verde); }
</style>
