---
// 1) Portada del Modelo de Formación (título principal de la página)
import Icono from '../Icono.astro';

interface Props {
  etiqueta: string;
  titulo: string;
  lema: string;
  botones?: { texto: string; url: string }[];
}
const { etiqueta, titulo, lema, botones = [] } = Astro.props;
---
<section class="f-hero">
  <div class="contenedor f-hero__contenido">
    <span class="f-hero__sello"><Icono nombre="birrete" tam={18} /> {etiqueta}</span>
    <h1>{titulo}</h1>
    <p class="f-hero__lema">“{lema}”</p>
    <div class="linea-dorada"></div>
    {botones.length > 0 && (
      <div class="f-hero__botones">
        {botones.map((b, i) => (
          <a href={b.url} class:list={['boton', i === 0 ? 'boton--dorado' : 'boton--borde-claro']}>
            {b.texto} {i === 0 && <Icono nombre="flecha" tam={18} />}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .f-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 12vw, 8.5rem) 0 clamp(4rem, 9vw, 6.5rem);
    text-align: center;
    color: #dfe8e2;
    background:
      radial-gradient(circle at 15% 85%, rgba(201, 162, 39, 0.16), transparent 45%),
      linear-gradient(160deg, var(--verde-oscuro), var(--verde-noche));
  }
  /* Aros dorados decorativos */
  .f-hero::before,
  .f-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgba(232, 206, 115, 0.4);
    pointer-events: none;
  }
  .f-hero::before { width: 760px; height: 760px; right: -480px; top: -470px; }
  .f-hero::after { width: 560px; height: 560px; left: -380px; bottom: -430px; border-color: rgba(232, 206, 115, 0.25); }

  .f-hero__contenido { position: relative; max-width: 860px; animation: f-entrar 0.9s ease both; }

  .f-hero__sello {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1.1rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(232, 206, 115, 0.5);
    border-radius: var(--formacion-radio-pastilla);
    color: var(--dorado-claro);
    font-size: var(--tam-etiqueta);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .f-hero h1 { color: var(--blanco); font-size: clamp(2rem, 6vw, 4rem); }
  .f-hero__lema {
    margin-top: 1rem;
    font-family: var(--fuente-acento);
    font-style: italic;
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    color: var(--dorado-claro);
  }
  .f-hero__botones {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }
  @media (min-width: 560px) {
    .f-hero__botones { flex-direction: row; justify-content: center; }
  }

  @keyframes f-entrar {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .f-hero__contenido { animation: none; }
  }
</style>
