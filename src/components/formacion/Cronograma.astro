---
// 12) Cronograma: una tarjeta por mes, con filtro por línea de formación.
// El día de la semana se calcula a partir de la fecha (AAAA-MM-DD).
import Encabezado from '../Encabezado.astro';
import Icono from '../Icono.astro';
import EtiquetaLinea from './EtiquetaLinea.astro';

interface Mes { mes: string; programa: string; linea: string; fechas: string[] }
interface Props {
  id?: string;
  etiqueta?: string;
  titulo: string;
  sesiones?: string;
  meses: Mes[];
  lineas: { id: string; nombre: string }[];
}
const { id = 'cronograma', etiqueta, titulo, sesiones, meses, lineas } = Astro.props;

const nombreLinea = (idLinea: string) =>
  idLinea === 'todas' ? 'Todas las líneas' : lineas.find((l) => l.id === idLinea)?.nombre ?? idLinea;

// "2027-01-19" → { corto: "mar 19", largo: "martes, 19 de enero de 2027" }
const formatearFecha = (iso: string) => {
  const fecha = new Date(`${iso}T12:00:00`);
  const dia = new Intl.DateTimeFormat('es-CO', { weekday: 'short' }).format(fecha).replace('.', '');
  const largo = new Intl.DateTimeFormat('es-CO', { dateStyle: 'full' }).format(fecha);
  return { dia, numero: fecha.getDate(), largo };
};
---
<section class="seccion seccion--blanca" id={id}>
  <div class="contenedor">
    <Encabezado etiqueta={etiqueta} titulo={titulo} />

    <div class="filtro" role="group" aria-label="Filtrar cronograma por línea" data-filtro>
      <button type="button" class="filtro__boton" aria-pressed="true" data-linea="todas">Todas</button>
      {lineas.map((l) => (
        <button type="button" class="filtro__boton" aria-pressed="false" data-linea={l.id}>{l.nombre}</button>
      ))}
    </div>
    <p class="oculto-visual" aria-live="polite" data-filtro-estado></p>

    <ol class="meses">
      {meses.map((m) => (
        <li class="mes aparecer" data-linea-mes={m.linea} style={`--color-linea: ${m.linea === 'todas' ? 'var(--dorado)' : `var(--formacion-linea-${m.linea})`}`}>
          <div class="mes__cabeza">
            <h3>{m.mes}</h3>
            <EtiquetaLinea linea={m.linea} texto={nombreLinea(m.linea)} />
          </div>
          <p class="mes__programa">{m.programa}</p>
          <ul class="mes__fechas" aria-label="Fechas de las sesiones">
            {m.fechas.map((f) => {
              const d = formatearFecha(f);
              return (
                <li>
                  <time datetime={f} title={d.largo}>
                    <span class="mes__dia-semana">{d.dia}</span>
                    <span class="mes__dia">{d.numero}</span>
                  </time>
                </li>
              );
            })}
          </ul>
          {sesiones && <p class="mes__sesiones"><Icono nombre="reloj" tam={14} /> {sesiones}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Filtro del cronograma por línea (los meses de "todas" se muestran siempre)
  document.querySelectorAll<HTMLElement>('[data-filtro]').forEach((filtro) => {
    const seccion = filtro.closest('section');
    const botones = filtro.querySelectorAll<HTMLButtonElement>('[data-linea]');
    const meses = seccion?.querySelectorAll<HTMLElement>('[data-linea-mes]') ?? [];
    const estado = seccion?.querySelector<HTMLElement>('[data-filtro-estado]');

    botones.forEach((boton) =>
      boton.addEventListener('click', () => {
        const linea = boton.dataset.linea;
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
        let visibles = 0;
        meses.forEach((mes) => {
          const mostrar = linea === 'todas' || mes.dataset.lineaMes === linea || mes.dataset.lineaMes === 'todas';
          mes.hidden = !mostrar;
          if (mostrar) visibles++;
        });
        if (estado) estado.textContent = `Mostrando ${visibles} meses`;
      })
    );
  });
</script>

<style>
  .filtro {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filtro__boton {
    padding: 0.55rem 1.2rem;
    border-radius: var(--formacion-radio-pastilla);
    border: 1px solid var(--borde);
    background: var(--blanco);
    color: var(--texto-suave);
    font-size: var(--tam-pequeno);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transicion);
  }
  .filtro__boton:hover { border-color: var(--dorado); color: var(--verde-oscuro); }
  .filtro__boton[aria-pressed='true'] { background: var(--verde-oscuro); border-color: var(--verde-oscuro); color: var(--dorado-claro); }

  .meses {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .mes {
    display: flex;
    flex-direction: column;
    padding: 1.2rem 1.3rem;
    border-radius: var(--radio);
    background: var(--crema);
    border: 1px solid var(--borde);
    border-top: 4px solid var(--color-linea);
    box-shadow: var(--sombra);
  }
  .mes__cabeza { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .mes__cabeza h3 { font-size: 1.05rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .mes__programa { margin: 0.7rem 0 1rem; font-weight: 600; color: var(--texto); flex: 1; }
  .mes__fechas { display: flex; gap: 0.6rem; }
  .mes__fechas time {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 56px;
    padding: 0.35rem 0.6rem;
    border-radius: calc(var(--radio) - 4px);
    background: var(--blanco);
    border: 1px solid var(--dorado-suave);
    line-height: 1.2;
  }
  .mes__dia-semana { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--verde); }
  .mes__dia { font-family: var(--fuente-titulos); font-size: 1.4rem; font-weight: 700; color: var(--verde-oscuro); }
  .mes__sesiones {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--texto-suave);
  }
</style>
