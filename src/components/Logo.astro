---
// Logo de GENTAU (gancho + nombre + eslogan). Se dibuja con código,
// así se ve nítido en cualquier tamaño. tono: 'claro' | 'oscuro'
interface Props { tono?: 'claro' | 'oscuro'; tam?: 'normal' | 'grande' }
const { tono = 'oscuro', tam = 'normal' } = Astro.props;
---
<span class:list={['logo', `logo--${tono}`, `logo--${tam}`]}>
  <svg class="logo__gancho" viewBox="0 0 64 30" aria-hidden="true">
    <path d="M32 9a4 4 0 1 1 4-4c0 2-4 2.6-4 5.5L4.5 25.5a1.6 1.6 0 0 0 .9 3h53.2a1.6 1.6 0 0 0 .9-3L32 10.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="logo__nombre">GENTAU</span>
  <span class="logo__eslogan">Moda que inspira</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .logo__gancho { width: 34px; height: 16px; color: var(--dorado); margin-bottom: 2px; }
  .logo__nombre {
    font-family: var(--fuente-titulos);
    font-weight: 700;
    font-size: 1.55rem;
    letter-spacing: 0.08em;
  }
  .logo__eslogan {
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    margin-top: 4px;
    color: var(--dorado);
  }
  .logo--oscuro .logo__nombre { color: var(--verde-oscuro); }
  .logo--claro .logo__nombre {
    background: var(--degradado-dorado);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .logo--claro .logo__eslogan { color: var(--dorado-claro); }

  .logo--grande .logo__gancho { width: 70px; height: 33px; }
  .logo--grande .logo__nombre { font-size: 2.6rem; }
  .logo--grande .logo__eslogan { font-size: 0.75rem; }
</style>
