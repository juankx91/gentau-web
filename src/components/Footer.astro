---
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h4>{SITE.name}</h4>
      <p>{SITE.slogan}</p>
      <p>Ropa femenina y masculina pensada para todos los cuerpos.</p>
    </div>
    <div>
      <h4>Explora</h4>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/productos">Productos</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </div>
    <div>
      <h4>Escríbenos</h4>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.phone}</li>
        <li>{SITE.address}</li>
        <li><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>
  </div>
  <div class="wordmark" aria-hidden="true">{SITE.name}</div>
  <div class="footer-bottom">
    <div class="wrap" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
      <span>© {year} {SITE.name}. Todos los derechos reservados.</span>
      <a href="/admin">Administración</a>
    </div>
  </div>
</footer>
