---
// Pie de página con contacto, enlaces, redes y mini mapa.
// Los datos se cambian en: src/config/site.js
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { site, menu } from '../config/site.js';

const urlMapa = `https://www.google.com/maps?q=${encodeURIComponent(site.mapa)}&output=embed`;
const urlComoLlegar = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapa)}`;
const gente = menu.find((m) => m.hijos)?.hijos ?? [];
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
---
<footer class="footer" id="contacto">
  <div class="footer__brillo" aria-hidden="true"></div>
  <div class="contenedor footer__grid">
    <div class="footer__marca">
      <Logo tono="claro" tam="grande" />
      <p class="footer__texto">{site.descripcion}</p>
      <div class="footer__redes">
        {redes.map(([red, url]) => (
          <a href={url} target="_blank" rel="noopener" aria-label={red}><Icono nombre={red} tam={18} /></a>
        ))}
      </div>
    </div>

    <div>
      <h4 class="footer__titulo">Navegación</h4>
      <ul class="footer__lista">
        {menu.map((m) => <li><a href={m.url}>{m.texto}</a></li>)}
      </ul>
    </div>

    <div>
      <h4 class="footer__titulo">Nuestra gente</h4>
      <ul class="footer__lista">
        {gente.map((m) => <li><a href={m.url}>{m.texto}</a></li>)}
      </ul>
    </div>

    <div class="footer__contacto">
      <h4 class="footer__titulo">Visítanos</h4>
      <div class="footer__mapa">
        <iframe
          src={urlMapa}
          title={`Ubicación de ${site.nombre}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <ul class="footer__datos">
        <li><Icono nombre="ubicacion" tam={18} /><a href={urlComoLlegar} target="_blank" rel="noopener">{site.direccion}</a></li>
        <li><Icono nombre="telefono" tam={18} /><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">{site.telefono}</a></li>
        <li><Icono nombre="correo" tam={18} /><a href={`mailto:${site.correo}`}>{site.correo}</a></li>
        <li><Icono nombre="reloj" tam={18} /><span>{site.horario}</span></li>
      </ul>
    </div>
  </div>

  <div class="footer__base">
    <div class="contenedor footer__base-fila">
      <p>© {anio} {site.nombre} · {site.lema}</p>
      <a href="/admin" class="footer__admin">Administrador</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--verde-noche);
    color: #b9c8bf;
    padding-top: 5rem;
    border-top: 3px solid var(--dorado);
  }
  .footer__brillo {
    position: absolute;
    width: 600px;
    height: 600px;
    top: -300px;
    right: -200px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.16), transparent 65%);
    pointer-events: none;
  }
  .footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }
  .footer__marca { display: flex; flex-direction: column; align-items: flex-start; }
  .footer__texto { margin: 1.5rem 0; font-size: 0.92rem; line-height: 1.8; }

  .footer__redes { display: flex; gap: 0.7rem; }
  .footer__redes a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(232, 206, 115, 0.4);
    color: var(--dorado-claro);
    transition: all var(--transicion);
  }
  .footer__redes a:hover { background: var(--dorado); color: var(--verde-noche); transform: translateY(-3px); }

  .footer__titulo {
    font-size: 0.95rem;
    color: var(--dorado-claro);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.4rem;
  }
  .footer__lista li { margin-bottom: 0.7rem; }
  .footer__lista a { font-size: 0.9rem; transition: color var(--transicion), padding var(--transicion); }
  .footer__lista a:hover { color: var(--dorado-claro); padding-left: 4px; }

  .footer__mapa {
    border-radius: var(--radio);
    overflow: hidden;
    border: 2px solid rgba(232, 206, 115, 0.35);
    height: 170px;
    margin-bottom: 1.2rem;
  }
  .footer__mapa iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.25) contrast(1.05); }

  .footer__datos li { display: flex; align-items: flex-start; gap: 0.7rem; margin-bottom: 0.65rem; font-size: 0.88rem; }
  .footer__datos :global(svg) { color: var(--dorado); flex-shrink: 0; margin-top: 3px; }
  .footer__datos a:hover { color: var(--dorado-claro); }

  .footer__base { border-top: 1px solid rgba(255, 255, 255, 0.08); padding: 1.4rem 0; font-size: 0.8rem; }
  .footer__base-fila { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .footer__admin { color: #7f948a; }
  .footer__admin:hover { color: var(--dorado-claro); }

  @media (max-width: 1000px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .footer__grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
