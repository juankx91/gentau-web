---
// PLAN DE BIENESTAR LABORAL 2027
// Los textos están en: src/data/bienestar.js
import GenteLayout from '../../layouts/GenteLayout.astro';
import Encabezado from '../../components/Encabezado.astro';
import Icono from '../../components/Icono.astro';
import { bienestar as b } from '../../data/bienestar.js';
import { precioCOP } from '../../lib/formato.js';

const total = b.presupuesto.reduce((suma, fila) => suma + fila.valor, 0);
const totalActividades = b.componentes.reduce((s, c) => s + c.actividades.length, 0);
---
<GenteLayout
  etiqueta={`Plan de Bienestar Laboral ${b.anio}`}
  titulo={`“${b.lema}”`}
  texto="Cuidamos a cada colaborador como persona, no solo como trabajador."
  imagen="/img/bienestar-portada.jpg"
>
  <!-- INTRODUCCIÓN + OBJETIVO GENERAL -->
  <section class="seccion">
    <div class="contenedor dos-columnas">
      <div class="aparecer">
        <span class="etiqueta">Introducción</span>
        <h2>Un equipo feliz crea moda con más pasión</h2>
        {b.introduccion.map((p) => <p class="texto-suave mt-2">{p}</p>)}
      </div>
      <div class="objetivo-general aparecer">
        <span class="icono-circulo"><Icono nombre="estrella" /></span>
        <span class="etiqueta">Objetivo general</span>
        <p class="frase">{b.objetivoGeneral}</p>
      </div>
    </div>
  </section>

  <!-- OBJETIVOS ESPECÍFICOS -->
  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <Encabezado etiqueta="Lo que buscamos" titulo="Objetivos específicos" />
      <div class="grid grid-3">
        {b.objetivosEspecificos.map((o, i) => (
          <article class="tarjeta centrado aparecer">
            <span class="icono-circulo centro"><Icono nombre={o.icono} /></span>
            <h3>Objetivo {i + 1}</h3>
            <p>{o.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ALCANCE Y MARCO NORMATIVO -->
  <section class="seccion">
    <div class="contenedor grid grid-2 alcance-marco">
      <div class="aparecer">
        <Encabezado etiqueta="Alcance" titulo="¿A quién va dirigido?" izquierda />
        <ul class="lista-check">
          {b.alcance.map((a) => <li>{a}</li>)}
        </ul>
        <div class="importancia mt-3">
          {b.importancia.map((i) => (
            <div class="importancia__item">
              <Icono nombre={i.icono} tam={22} />
              <div><strong>{i.titulo}</strong><span>{i.texto}</span></div>
            </div>
          ))}
        </div>
      </div>
      <div class="aparecer">
        <Encabezado etiqueta="Marco normativo" titulo="Normas que respaldan el plan" izquierda />
        <ul class="normas">
          {b.marcoNormativo.map((n) => (
            <li><strong>{n.norma}</strong><span>{n.tema}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- COMPONENTES (pestañas) -->
  <section class="seccion seccion--verde">
    <div class="contenedor">
      <Encabezado etiqueta={`${totalActividades} actividades en ${b.anio}`} titulo="Siete componentes de bienestar" texto="Tres actividades por cada componente, con su objetivo y descripción." />

      <div class="pestanas" role="tablist">
        {b.componentes.map((c, i) => (
          <button role="tab" class:list={['pestana', { activa: i === 0 }]} data-pestana={i} aria-selected={i === 0 ? 'true' : 'false'}>
            <Icono nombre={c.icono} tam={18} /> {c.nombre}
          </button>
        ))}
      </div>

      {b.componentes.map((c, i) => (
        <div class="panel" data-panel={i} hidden={i !== 0} role="tabpanel">
          <p class="panel__frase">“{c.frase}”</p>
          <div class="grid grid-3">
            {c.actividades.map((a) => (
              <article class="actividad">
                <h3>{a.titulo}</h3>
                <p><strong>Objetivo:</strong> {a.objetivo}</p>
                <p><strong>Descripción:</strong> {a.descripcion}</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CRONOGRAMA -->
  <section class="seccion">
    <div class="contenedor">
      <Encabezado etiqueta={`Enero a diciembre de ${b.anio}`} titulo="Cronograma anual" />
      <div class="meses">
        {b.cronograma.map((m) => (
          <article class="mes aparecer">
            <h3>{m.mes}</h3>
            <ul>
              {m.eventos.map(([dia, evento]) => (
                <li><span class="mes__dia">{dia}</span>{evento}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="nota-anio"><Icono nombre="calendario" tam={18} /> {b.todoElAnio}</p>
    </div>
  </section>

  <!-- PRESUPUESTO E INDICADORES -->
  <section class="seccion seccion--blanca">
    <div class="contenedor grid grid-2">
      <div class="aparecer">
        <Encabezado etiqueta="Invertimos en lo más valioso" titulo="Presupuesto estimado" izquierda />
        <div class="tabla-envoltura">
          <table class="tabla">
            <thead><tr><th>Concepto</th><th>Valor estimado</th></tr></thead>
            <tbody>
              {b.presupuesto.map((f) => <tr><td>{f.concepto}</td><td>{precioCOP(f.valor)}</td></tr>)}
              <tr class="total"><td>Total</td><td>{precioCOP(total)}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="aparecer">
        <Encabezado etiqueta="Mediremos nuestro impacto" titulo="Indicadores de éxito" izquierda />
        <div class="indicadores">
          {b.indicadores.map((i) => (
            <div class="indicador"><strong>{i.valor}</strong><span>{i.texto}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CIERRE -->
  <section class="cierre">
    <div class="contenedor centrado">
      <p class="frase">“{b.fraseCierre}”</p>
      <p class="cierre__lema">¡Sigamos creando moda… con bienestar!</p>
    </div>
  </section>
</GenteLayout>

<script>
  // Pestañas de los 7 componentes
  const pestanas = document.querySelectorAll<HTMLButtonElement>('[data-pestana]');
  const paneles = document.querySelectorAll<HTMLElement>('[data-panel]');
  pestanas.forEach((p) =>
    p.addEventListener('click', () => {
      pestanas.forEach((x) => { x.classList.remove('activa'); x.setAttribute('aria-selected', 'false'); });
      p.classList.add('activa');
      p.setAttribute('aria-selected', 'true');
      paneles.forEach((panel) => (panel.hidden = panel.dataset.panel !== p.dataset.pestana));
    })
  );
</script>

<style>
  .objetivo-general {
    padding: 3rem;
    border-radius: var(--radio-grande);
    background: var(--blanco);
    border: 1px solid var(--dorado-suave);
    box-shadow: var(--sombra-fuerte);
    text-align: center;
  }
  .objetivo-general .icono-circulo { margin-inline: auto; }
  .centro { margin-inline: auto; }

  .alcance-marco { gap: 3rem; align-items: start; }
  .alcance-marco :global(.encabezado) { margin-bottom: 1.5rem; }
  .importancia { display: grid; gap: 1rem; }
  .importancia__item { display: flex; gap: 1rem; padding: 1rem 1.2rem; background: var(--blanco); border-radius: var(--radio); border: 1px solid var(--borde); }
  .importancia__item :global(svg) { color: var(--dorado); flex-shrink: 0; margin-top: 3px; }
  .importancia__item strong { display: block; color: var(--verde-oscuro); font-size: 0.95rem; }
  .importancia__item span { font-size: 0.86rem; color: var(--texto-suave); }

  .normas { display: grid; gap: 0.7rem; }
  .normas li {
    display: flex; flex-direction: column;
    padding: 1rem 1.3rem;
    background: var(--blanco);
    border-left: 4px solid var(--dorado);
    border-radius: 0 var(--radio) var(--radio) 0;
    box-shadow: var(--sombra);
  }
  .normas strong { font-family: var(--fuente-titulos); color: var(--verde-oscuro); }
  .normas span { font-size: 0.88rem; color: var(--texto-suave); }

  .pestanas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-bottom: 2.5rem; }
  .pestana {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    border: 1px solid rgba(232, 206, 115, 0.4);
    background: transparent;
    color: #d7e2dc;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transicion);
  }
  .pestana:hover { border-color: var(--dorado-claro); color: var(--dorado-claro); }
  .pestana.activa { background: var(--degradado-dorado); color: var(--verde-noche); border-color: transparent; font-weight: 600; }
  .panel__frase { text-align: center; font-family: var(--fuente-acento); font-style: italic; font-size: 1.6rem; color: var(--dorado-claro); margin-bottom: 2rem; }
  .actividad { padding: 2rem; border-radius: var(--radio); background: var(--blanco); border-top: 4px solid var(--dorado); }
  .actividad h3 { color: var(--verde-oscuro) !important; margin-bottom: 1rem; }
  .actividad p { font-size: 0.9rem; color: var(--texto-suave); margin-bottom: 0.6rem; }
  .actividad strong { color: var(--verde); }

  .meses { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.2rem; }
  .mes { background: var(--blanco); border-radius: var(--radio); overflow: hidden; border: 1px solid var(--borde); box-shadow: var(--sombra); }
  .mes h3 { background: var(--verde-oscuro); color: var(--dorado-claro); padding: 0.8rem 1.2rem; font-size: 0.95rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .mes ul { padding: 1rem 1.2rem; }
  .mes li { display: flex; align-items: center; gap: 0.8rem; padding: 0.4rem 0; font-size: 0.88rem; color: var(--texto-suave); }
  .mes__dia {
    display: grid; place-items: center; flex-shrink: 0;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--menta); color: var(--verde-oscuro); font-weight: 700; font-size: 0.82rem;
    border: 1px solid var(--dorado-suave);
  }
  .nota-anio { display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin-top: 2rem; color: var(--verde); font-weight: 500; text-align: center; }

  .tabla .total td { background: var(--menta) !important; font-weight: 700; color: var(--verde-oscuro); }
  .indicadores { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .indicador {
    padding: 1.8rem 1.2rem; text-align: center; border-radius: var(--radio);
    background: linear-gradient(160deg, var(--verde-oscuro), var(--verde-noche));
    border: 1px solid rgba(232, 206, 115, 0.35);
  }
  .indicador strong { display: block; font-family: var(--fuente-titulos); font-size: 2.4rem; color: var(--dorado-claro); line-height: 1.1; }
  .indicador span { font-size: 0.85rem; color: #c3d1c9; }

  .cierre { padding: var(--espacio-seccion) 0; background: var(--menta); }
  .cierre .frase { max-width: 820px; margin-inline: auto; }
  .cierre__lema { margin-top: 1.5rem; font-family: var(--fuente-titulos); color: var(--dorado); letter-spacing: 0.1em; }
</style>
