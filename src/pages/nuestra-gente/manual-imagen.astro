---
// MANUAL DE PRESENTACIÓN PERSONAL E IMAGEN CORPORATIVA
// Los textos están en: src/data/manual.js
import GenteLayout from '../../layouts/GenteLayout.astro';
import Encabezado from '../../components/Encabezado.astro';
import Icono from '../../components/Icono.astro';
import { manual as m } from '../../data/manual.js';
---
<GenteLayout
  etiqueta="Manual de presentación personal"
  titulo="Imagen corporativa"
  texto={`“${m.lema}”`}
  imagen="/img/perchero.jpg"
>
  <section class="seccion">
    <div class="contenedor dos-columnas">
      <div class="aparecer">
        <div class="pilares-manual">{m.pilares.map((p) => <span>{p}</span>)}</div>
        <span class="etiqueta">Objetivo</span>
        <h2>Proyectamos nuestra esencia</h2>
        <p class="texto-suave mt-2">{m.objetivo}</p>
        <p class="texto-suave mt-2"><strong>Alcance:</strong> {m.alcance}</p>
      </div>
      <div class="tarjeta tarjeta--verde aparecer">
        <h3>Presentación personal general</h3>
        <p class="mt-2">Todos los colaboradores deberán:</p>
        <ul class="general">{m.general.map((g) => <li><Icono nombre="check" tam={18} /> {g}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <Encabezado etiqueta="Lineamientos por área" titulo="Cada equipo, una imagen coherente" />
      <div class="grid grid-3">
        {m.grupos.map((g) => (
          <article class="grupo aparecer">
            <div class="grupo__img" style={`background-image:url('${g.imagen}')`}>
              <span class="icono-circulo"><Icono nombre={g.icono} /></span>
            </div>
            <div class="grupo__cuerpo">
              <h3>{g.titulo}</h3>
              <p class="texto-suave">{g.intro}</p>
              <ul class="lista-check mt-2">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor grid grid-3">
      <article class="tarjeta aparecer">
        <span class="icono-circulo"><Icono nombre="estrella" /></span>
        <h3>Comportamiento e imagen</h3>
        <p>{m.comportamiento.intro}</p>
        <ul class="lista-check mt-2">{m.comportamiento.items.map((i) => <li>{i}</li>)}</ul>
      </article>
      <article class="tarjeta aparecer">
        <span class="icono-circulo"><Icono nombre="maletin" /></span>
        <h3>Responsabilidades de la empresa</h3>
        <ul class="lista-check mt-2">{m.responsabilidades.empresa.map((i) => <li>{i}</li>)}</ul>
        <h3 class="mt-2">De los colaboradores</h3>
        <ul class="lista-check mt-2">{m.responsabilidades.colaboradores.map((i) => <li>{i}</li>)}</ul>
      </article>
      <article class="tarjeta tarjeta--verde aparecer">
        <span class="icono-circulo"><Icono nombre="medalla" /></span>
        <h3>Cumplimiento</h3>
        <p>{m.cumplimiento}</p>
        <p class="sello-manual">Responsabilidad y compromiso</p>
      </article>
    </div>
  </section>

  <section class="mensaje">
    <div class="contenedor centrado">
      <p class="frase">“{m.mensaje}”</p>
      <p class="mensaje__firma">¡Somos GENTAU!</p>
    </div>
  </section>
</GenteLayout>

<style>
  .pilares-manual { display: flex; gap: 0.6rem; margin-bottom: 1.8rem; flex-wrap: wrap; }
  .pilares-manual span { padding: 0.4rem 1rem; border-radius: 999px; background: var(--degradado-dorado); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--verde-noche); }
  .general li { display: flex; gap: 0.8rem; padding: 0.8rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #e1e9e4; }
  .general :global(svg) { color: var(--dorado-claro); flex-shrink: 0; margin-top: 3px; }

  .grupo { background: var(--blanco); border-radius: var(--radio); overflow: hidden; border: 1px solid var(--borde); box-shadow: var(--sombra); }
  .grupo__img { position: relative; height: 210px; background-size: cover; background-position: center; }
  .grupo__img .icono-circulo { position: absolute; left: 1.8rem; bottom: -29px; margin: 0; }
  .grupo__cuerpo { padding: 2.6rem 1.8rem 1.8rem; }
  .grupo__cuerpo h3 { margin-bottom: 0.4rem; }

  .sello-manual { margin-top: 1.5rem; display: inline-block; padding: 0.5rem 1.1rem; border: 1px solid var(--dorado-claro); border-radius: 999px; color: var(--dorado-claro) !important; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; }

  .mensaje {
    padding: var(--espacio-seccion) 0;
    background: linear-gradient(120deg, rgba(6, 42, 31, 0.95), rgba(11, 61, 46, 0.88)), url('/img/logo-gentau.jpg') center / cover;
  }
  .mensaje .frase { color: var(--blanco); max-width: 800px; margin-inline: auto; }
  .mensaje__firma { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-size: 1.5rem; color: var(--dorado-claro); letter-spacing: 0.1em; }
</style>
