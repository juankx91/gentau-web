---
// MANUAL DE POLÍTICAS INTERNAS Y PROCEDIMIENTOS
// Los textos están en: src/data/politicas.js
import GenteLayout from '../../layouts/GenteLayout.astro';
import Icono from '../../components/Icono.astro';
import { politicas, introduccionPoliticas } from '../../data/politicas.js';
---
<GenteLayout
  etiqueta="Documento de inducción"
  titulo="Políticas internas y procedimientos"
  texto="Inclusión, diseño, producción responsable, comunicación, formación y convivencia."
  imagen="/img/disenadora.jpg"
>
  <section class="seccion">
    <div class="contenedor">
      <p class="intro aparecer">{introduccionPoliticas}</p>

      <div class="politicas">
        {politicas.map((p, i) => (
          <article class="politica aparecer">
            <div class="politica__cabeza">
              <span class="icono-circulo"><Icono nombre={p.icono} /></span>
              <div>
                <span class="politica__num">{String(i + 2).padStart(2, '0')}</span>
                <h2>{p.titulo}</h2>
              </div>
            </div>
            <p class="texto-suave">{p.texto}</p>
            <h3 class="politica__sub">Procedimiento</h3>
            <ol class="pasos">
              {p.pasos.map((paso) => <li>{paso}</li>)}
            </ol>
          </article>
        ))}
      </div>

      <p class="aviso">
        Este documento es una plantilla base elaborada para el proceso de inducción de GENTAU y debe ser revisada, ajustada y
        formalizada por el área legal y de Talento Humano de la empresa antes de su adopción oficial.
      </p>
    </div>
  </section>
</GenteLayout>

<style>
  .intro { max-width: 820px; margin: 0 auto 3.5rem; text-align: center; font-family: var(--fuente-acento); font-size: 1.35rem; color: var(--verde-oscuro); }
  .politicas { display: grid; grid-template-columns: repeat(auto-fit, minmax(460px, 1fr)); gap: 1.5rem; }
  @media (max-width: 560px) { .politicas { grid-template-columns: 1fr; } }
  .politica { padding: 2.2rem; background: var(--blanco); border-radius: var(--radio); border: 1px solid var(--borde); box-shadow: var(--sombra); }
  .politica__cabeza { display: flex; gap: 1.1rem; align-items: center; margin-bottom: 1rem; }
  .politica__cabeza .icono-circulo { margin: 0; }
  .politica__num { font-size: 0.72rem; letter-spacing: 0.2em; color: var(--dorado); font-weight: 600; }
  .politica h2 { font-size: 1.15rem; }
  .politica__sub { margin: 1.5rem 0 0.8rem; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dorado); }
  .pasos { counter-reset: paso; list-style: none; }
  .pasos li { counter-increment: paso; position: relative; padding-left: 2.6rem; margin-bottom: 0.9rem; font-size: 0.92rem; color: var(--texto-suave); }
  .pasos li::before {
    content: counter(paso);
    position: absolute; left: 0; top: 0;
    display: grid; place-items: center;
    width: 26px; height: 26px; border-radius: 50%;
    background: var(--verde-oscuro); color: var(--dorado-claro); font-size: 0.78rem; font-weight: 700;
  }
  .aviso { margin-top: 3rem; padding: 1.2rem 1.5rem; border-radius: var(--radio); background: #fbf6e6; border: 1px dashed var(--dorado); font-size: 0.86rem; color: var(--texto-suave); text-align: center; }
</style>
