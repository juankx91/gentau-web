---
import Layout from '../../layouts/Layout.astro';
const error = Astro.url.searchParams.has('error');
---
<Layout title="Ingreso" bare>
  <form class="login-box" method="POST" action="/api/login">
    <h1>Panel de administrador</h1>
    <div class="field">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" required autofocus autocomplete="current-password" />
    </div>
    {error && <p class="status error">Contraseña incorrecta.</p>}
    <button class="btn btn-green" type="submit">Ingresar</button>
  </form>
</Layout>
