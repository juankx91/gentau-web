---
import Layout from '../layouts/Layout.astro';
import { getProducts } from '../lib/db';
import { optimize } from '../lib/cloudinary';

const products = await getProducts();
---
<Layout title="Productos" description="Conoce las prendas de GENTAU.">
  <section class="page-head">
    <div class="wrap">
      <h1>Nuestros productos</h1>
      <p>Prendas con diseño propio, hechas para todo tipo de cuerpos, edades y estilos.</p>
    </div>
  </section>
  <section class="section dark">
    <div class="wrap">
      {products.length === 0 ? (
        <p class="empty">Pronto publicaremos nuestras prendas. Vuelve a visitarnos.</p>
      ) : (
        <div class="pgrid">
          {products.map((p, i) => (
            <article class="pcard reveal" data-tilt style={`--i:${i % 4}`}>
              <div class="pimg">
                {p.image_url
                  ? <img src={optimize(p.image_url, 'f_auto,q_auto,c_fill,w_600,h_750')} alt={p.name} loading="lazy" />
                  : <div class="placeholder">{p.name.charAt(0).toUpperCase()}</div>}
              </div>
              <div class="pbody">
                <h3>{p.name}</h3>
                <p>{p.description}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
