---
// PÁGINA SOBRE NOSOTROS
// Los textos están en: src/data/empresa.js
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Encabezado from '../components/Encabezado.astro';
import Icono from '../components/Icono.astro';
import {
  historia, quienesSomos, mision, vision, valores, cultura, clima, objetivosGenerales, objetivosEspecificos,
} from '../data/empresa.js';
---
<BaseLayout titulo="Sobre nosotros" descripcion="Conoce la historia, misión, visión, valores y cultura de GENTAU.">
  <PageHero etiqueta="Sobre nosotros" titulo="Moda sin barreras, hecha con propósito" texto="Diseño propio, tallas reales e impacto social en cada prenda." imagen="/img/boutique.jpg" />

  <!-- HISTORIA -->
  <section class="seccion">
    <div class="contenedor dos-columnas">
      <div class="aparecer">
        <span class="etiqueta">De dónde venimos</span>
        <h2>{historia.titulo}</h2>
        {historia.parrafos.map((p) => <p class="texto-suave mt-2">{p}</p>)}
        <p class="cierre-historia">{historia.cierre}</p>
      </div>
      <div class="camino aparecer">
        <h3 class="camino__titulo">El camino hasta hoy</h3>
        {historia.camino.map((paso, i) => (
          <div class="camino__paso">
            <span class="icono-circulo"><Icono nombre={paso.icono} /></span>
            <div>
              <span class="camino__num">0{i + 1}</span>
              <h4>{paso.titulo}</h4>
              <p>{paso.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section class="seccion seccion--blanca">
    <div class="contenedor dos-columnas dos-columnas--invertido">
      <div class="aparecer">
        <span class="etiqueta">Quiénes somos</span>
        <h2>{quienesSomos.titulo}</h2>
        <p class="texto-suave mt-2">{quienesSomos.texto}</p>
        <div class="grid grid-3 mt-2">
          {quienesSomos.pilares.map((p) => (
            <div class="mini">
              <Icono nombre={p.icono} tam={28} />
              <strong>{p.titulo}</strong>
              <span>{p.texto}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="imagen-marco aparecer">
        <img src="/img/perchero.jpg" alt="Prendas GENTAU en exhibición" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- MISIÓN Y VISIÓN -->
  <section class="seccion seccion--verde" id="mision-vision">
    <div class="contenedor">
      <Encabezado etiqueta="Nuestro rumbo" titulo="Misión y Visión" />
      <div class="grid grid-2">
        <article class="mv aparecer">
          <span class="mv__etiqueta"><Icono nombre="bandera" tam={20} /> Misión</span>
          <p>{mision}</p>
        </article>
        <article class="mv aparecer">
          <span class="mv__etiqueta"><Icono nombre="grafica" tam={20} /> Visión</span>
          <p>{vision}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="seccion" id="valores">
    <div class="contenedor">
      <Encabezado etiqueta="Lo que nos define" titulo="Nuestros valores" />
      <div class="grid grid-3">
        {valores.map((v, i) => (
          <article class="tarjeta aparecer">
            <span class="numero-fondo">0{i + 1}</span>
            <span class="icono-circulo"><Icono nombre={v.icono} /></span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CULTURA -->
  <section class="seccion seccion--menta" id="cultura">
    <div class="contenedor">
      <Encabezado etiqueta="Cultura organizacional" titulo="El ADN de GENTAU" texto={cultura.definicion} />
      <div class="grid grid-4">
        {cultura.principios.map((p) => (
          <article class="tarjeta aparecer">
            <span class="icono-circulo"><Icono nombre={p.icono} /></span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CLIMA -->
  <section class="seccion" id="clima">
    <div class="contenedor">
      <Encabezado etiqueta="Clima organizacional" titulo="Cómo nos sentimos trabajando aquí" texto={clima.definicion} />
      <div class="grid grid-2">
        {clima.principios.map((p) => (
          <article class="tarjeta clima aparecer">
            <span class="icono-circulo"><Icono nombre={p.icono} /></span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- OBJETIVOS -->
  <section class="seccion seccion--verde" id="objetivos">
    <div class="contenedor">
      <Encabezado etiqueta="Largo plazo" titulo="Hacia dónde vamos" />
      <div class="grid grid-2">
        {objetivosGenerales.map((o) => (
          <article class="tarjeta tarjeta--verde aparecer">
            <span class="icono-circulo"><Icono nombre={o.icono} /></span>
            <h3>{o.titulo}</h3>
            <p>{o.texto}</p>
          </article>
        ))}
      </div>

      <h3 class="subtitulo-objetivos aparecer">Objetivos específicos · corto y mediano plazo</h3>
      <div class="grid grid-2">
        {objetivosEspecificos.map((o) => (
          <article class="objetivo aparecer">
            <h4><Icono nombre={o.icono} tam={20} /> {o.area}</h4>
            <ul class="lista-check">
              {o.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cierre-historia {
    margin-top: 2rem;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--dorado);
    background: var(--blanco);
    border-radius: 0 var(--radio) var(--radio) 0;
    font-family: var(--fuente-acento);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--verde-oscuro);
    box-shadow: var(--sombra);
  }
  .camino {
    padding: 2.5rem;
    border-radius: var(--radio-grande);
    background: linear-gradient(160deg, var(--verde-oscuro), var(--verde-noche));
    border: 1px solid rgba(232, 206, 115, 0.3);
    box-shadow: var(--sombra-fuerte);
  }
  .camino__titulo { color: var(--dorado-claro); font-size: 1rem; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 2rem; }
  .camino__paso { display: flex; gap: 1.2rem; padding-bottom: 1.8rem; position: relative; }
  .camino__paso:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 62px;
    bottom: 4px;
    width: 1px;
    background: rgba(232, 206, 115, 0.4);
  }
  .camino__paso .icono-circulo { margin: 0; }
  .camino__num { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--dorado); }
  .camino__paso h4 { color: var(--blanco); font-size: 1.05rem; margin: 0.2rem 0 0.3rem; }
  .camino__paso p { color: #c3d1c9; font-size: 0.9rem; }

  .mini { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.2rem; border-radius: var(--radio); background: var(--menta); color: var(--verde-oscuro); }
  .mini strong { font-family: var(--fuente-titulos); }
  .mini span { font-size: 0.85rem; color: var(--texto-suave); }

  .mv {
    padding: 2.8rem;
    border-radius: var(--radio-grande);
    border: 1px solid rgba(232, 206, 115, 0.35);
    background: rgba(255, 255, 255, 0.04);
  }
  .mv__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.3rem;
    border-radius: 999px;
    background: var(--degradado-dorado);
    color: var(--verde-noche);
    font-family: var(--fuente-titulos);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .mv p { font-family: var(--fuente-acento); font-size: 1.35rem; line-height: 1.55; color: #eef3ef; }

  .numero-fondo {
    position: absolute;
    top: 1rem;
    right: 1.4rem;
    font-family: var(--fuente-titulos);
    font-size: 3rem;
    color: var(--dorado-suave);
    opacity: 0.6;
    line-height: 1;
  }
  .clima { display: flex; gap: 1.3rem; align-items: flex-start; }
  .clima .icono-circulo { margin: 0; }

  .subtitulo-objetivos { text-align: center; color: var(--dorado-claro) !important; margin: 4rem 0 2rem; letter-spacing: 0.12em; text-transform: uppercase; font-size: 1rem; }
  .objetivo { padding: 2rem; border-radius: var(--radio); background: var(--blanco); }
  .objetivo h4 { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.2rem; color: var(--verde-oscuro); }
  .objetivo h4 :global(svg) { color: var(--dorado); }
</style>
