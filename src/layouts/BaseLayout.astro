---
// Plantilla base: todas las páginas públicas usan este archivo.
// Incluye <head>, header, footer y la animación al hacer scroll.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site.js';

interface Props {
  titulo?: string;
  descripcion?: string;
  headerTransparente?: boolean;
}
const { titulo, descripcion = site.descripcion, headerTransparente = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${site.nombre}` : `${site.nombre} · ${site.eslogan}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#062a1f" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content="/img/logo-gentau.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Header transparente={headerTransparente} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Hace aparecer suavemente los elementos con la clase "aparecer"
      const observador = new IntersectionObserver(
        (entradas) => entradas.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('visible'); observador.unobserve(e.target); }
        }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.aparecer').forEach((el) => observador.observe(el));
    </script>
  </body>
</html>
